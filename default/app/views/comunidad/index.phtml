<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
document.addEventListener("DOMContentLoaded", function() {
    let mapaComu = L.map('mapa-cuidado-mutuo').setView([-34.6656, -58.7281], 13);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(mapaComu);

    // Mapeamos los datos de los amigos procesados en PHP directo a marcadores de Leaflet
    const amigosData = <?= json_encode($mis_amigos) ?>;
    let markersBounds = [];

    amigosData.forEach(amigo => {
        if (amigo.latitud && amigo.latitud !== "0") {
            const marker = L.marker([amigo.latitud, amigo.longitud])
                .addTo(mapaComu)
                .bindPopup(`<b>🛡️ Custodio: ${amigo.nombre}</b><br>Ubicación compartida en vivo.`);
            markersBounds.push([amigo.latitud, amigo.longitud]);
        }
    });

    // Ajustamos el zoom automáticamente para que abarque a todo tu grupo de confianza
    if (markersBounds.length > 0) {
        mapaComu.fitBounds(markersBounds, { padding: [40, 40] });
    }

    // 💬 GESTIÓN DINÁMICA DEL CHAT EN VIVO
    let amigoChatIdActual = null;
    let bucleChatInterval = null;
    const modalChat = new bootstrap.Modal(document.getElementById('modalChatComunidad'));
    const historialDiv = document.getElementById('historial-mensajes');
    const inputMensaje = document.getElementById('input-mensaje-chat');
    const btnEnviar = document.getElementById('btn-enviar-chat');
    const miUsuarioId = <?= $usuario_actual_id ?>;

    window.abrirChatModal = function(amigoId, nombreAmigo) {
        amigoChatIdActual = amigoId;
        document.getElementById('chat-titulo-nombre').textContent = "💬 " + nombreAmigo;
        historialDiv.innerHTML = "<span class='text-muted small text-center d-block py-2'>Conectando...</span>";
        modalChat.show();

        cargarMensajesServidor();
        // Encendemos un lector veloz de mensajes cada 2 segundos mientras esté el chat abierto
        if (bucleChatInterval) clearInterval(bucleChatInterval);
        bucleChatInterval = setInterval(cargarMensajesServidor, 2000);
    };

    function cargarMensajesServidor() {
        if (!amigoChatIdActual) return;
        fetch(`<?= PUBLIC_PATH ?>comunidad/chat_box/${amigoChatIdActual}`)
            .then(r => r.json())
            .then(mensajes => {
                historialDiv.innerHTML = "";
                if(mensajes.length === 0) {
                    historialDiv.innerHTML = "<span class='text-muted text-center d-block py-2' style='font-size:0.75rem;'>No hay mensajes previos. ¡Saludá!</span>";
                    return;
                }
                mensajes.forEach(m => {
                    const divMsg = document.createElement('div');
                    // Si el emisor soy yo, burbuja azul a la derecha. Si es el otro, gris a la izquierda.
                    const esMio = parseInt(m.emisor_id) === miUsuarioId;
                    divMsg.className = esMio ? "p-2 rounded-3 bg-primary text-white ms-auto max-w-75 shadow-sm" : "p-2 rounded-3 bg-white text-dark me-auto max-w-75 shadow-sm border";
                    divMsg.style.width = "fit-content";
                    divMsg.style.maxWidth = "80%";
                    divMsg.innerHTML = `<div>${m.mensaje}</div><span class='d-block text-end' style='font-size:0.6rem; opacity:0.8;'>${m.hora}</span>`;
                    historialDiv.appendChild(divMsg);
                });
                historialDiv.scrollTop = historialDiv.scrollHeight; // Auto scroll al último mensaje
            });
    }

    btnEnviar.addEventListener('click', mandarMensajeAccion);
    inputMensaje.addEventListener('keypress', function(e) { if(e.key === 'Enter') mandarMensajeAccion(); });

    function mandarMensajeAccion() {
        const texto = inputMensaje.value.trim();
        if(!texto || !amigoChatIdActual) return;

        const fd = new FormData();
        fd.append('mensaje', texto);

        fetch(`<?= PUBLIC_PATH ?>comunidad/chat_box/${amigoChatIdActual}`, { method: 'POST', body: fd })
            .then(r => r.json())
            .then(() => {
                inputMensaje.value = "";
                cargarMensajesServidor();
            });
    }

    // Al cerrar el modal de chat apagamos el lector periódico para no saturar XAMPP
    document.getElementById('modalChatComunidad').addEventListener('hidden.bs.modal', () => {
        if (bucleChatInterval) clearInterval(bucleChatInterval);
    });
});
</script>


<script>
document.getElementById('form-agregar-companero').addEventListener('submit', function(e) {
    e.preventDefault(); // Evitamos el refresco de página

    const select = this.querySelector('select[name="amigo_id"]');
    if (!select.value) return;

    const url = this.action;
    const datos = new URLSearchParams();
    datos.append('amigo_id', select.value);

    fetch(url, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'X-Requested-With': 'XMLHttpRequest'
        },
        body: datos.toString(),
        credentials: 'include'
    })
    .then(res => {
        if (!res.ok) throw new Error('Error en el servidor');
        return res.json();
    })
    .then(data => {
        alert(data.message);
        if (data.status === 'ok') {
            // Elimina al compañero seleccionado de la lista actual para que no se duplique visualmente
            select.querySelector(`option[value="${select.value}"]`).remove();
            select.value = ""; // Resetea el combo
            
            // Opcional: si querés actualizar la tabla de la comunidad abajo, podés meter un location.reload() 
            // o remover el elemento del DOM dinámicamente.
            location.reload(); 
        }
    })
    .catch(err => {
        console.error('Error:', err);
        alert('No se pudo añadir al compañero.');
    });
});
</script>