    <script>
        // Sincronización del estado de red global para la app activa
        document.addEventListener("DOMContentLoaded", function() {
            const bannerOffline = document.getElementById('banner-modo-offline');

            function actualizarBannerRed() {
                if (!navigator.onLine) {
                    bannerOffline.classList.remove('d-none');
                } else {
                    bannerOffline.classList.add('d-none');
                }
            }

            window.addEventListener('online', actualizarBannerRed);
            window.addEventListener('offline', actualizarBannerRed);
            actualizarBannerRed(); // Chequeo inicial de carga
        });

        // Registro estándar del Service Worker
        if ('serviceWorker' in navigator && 'PushManager' in window) {
            window.addEventListener('load', function() {
                navigator.serviceWorker.register('<?= PUBLIC_PATH ?>sw.js')
                .then(function(registration) {
                    console.log('Service Worker registrado con éxito: ', registration.scope);
                    return Notification.requestPermission();
                })
                .catch(function(err) {
                    console.error('Fallo en el SW:', err);
                });
            });
        }
    </script>

    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-messaging-compat.js"></script>
    <script>
    const firebaseConfig = {
        apiKey: "AIzaSy...",
        authDomain: "pulsounoapp.firebaseapp.com",
        projectId: "pulsounoapp",
        storageBucket: "pulsounoapp.appspot.com",
        messagingSenderId: "1234567890",
        appId: "1:1234567890:web:abcdef..."
    };

    firebase.initializeApp(firebaseConfig);
    try {
        const messaging = firebase.messaging();
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('<?= PUBLIC_PATH ?>sw.js')
            .then((registration) => {
                messaging.getToken({ 
                    serviceWorkerRegistration: registration,
                    vapidKey: 'TU_KEY_PUBLICA_DE_LA_CONSOLA_FIREBASE_WEB'
                })
                .then((currentToken) => {
                    if (currentToken) enviarTokenAlServidor(currentToken);
                }).catch(console.error);
            });
        }
    } catch(e) { console.warn("Firebase omitido en offline"); }

    function enviarTokenAlServidor(token) {
        if(!navigator.onLine) return; // Evitar fetch rotos en offline
        fetch('<?= PUBLIC_PATH ?>notificaciones/guardar_token_fcm', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ token: token })
        }).catch(() => console.log("Fallo envío de token por red"));
    }
    </script>
</body>
