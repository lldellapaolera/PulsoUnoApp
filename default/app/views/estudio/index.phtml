<script>
document.getElementById('btn-neuro-estudio').addEventListener('click', function() {
    const mins = document.getElementById('neuro-minutos').value;
    
    // PHP define la base y JavaScript concatena de forma segura de manera absoluta
    const urlBase = '<?= PUBLIC_PATH ?>'.replace(/\/+$/, ''); 
    const urlLimpia = window.location.origin + urlBase + '/estudio/registrar_estudio/' + mins;
    
    console.log("Petición enviada a:", urlLimpia);
    
    fetch(urlLimpia, {
        method: 'GET',
        headers: {
            'X-Requested-With': 'XMLHttpRequest'
        },
        credentials: 'include'
    })
    .then(res => {
        if (!res.ok) {
            throw new Error('Código de respuesta del servidor: ' + res.status);
        }
        return res.json();
    })
    .then(data => {
        alert(data.message);
        if(data.status !== 'error') {
            location.reload();
        }
    })
    .catch(err => {
        console.error('Error detectado en fetch:', err);
        alert('Ocurrió un error al procesar el bloque. Revisá la consola (F12).');
    });
});
function solicitarTregua(motivo) {
    if (confirm('¿Desea registrar una pausa regulada debido a: ' + motivo + '?')) {
        const urlBase = '<?= PUBLIC_PATH ?>'.replace(/\/+$/, '');
        
        // Mapeamos a una sola palabra clave limpia para evitar conflictos de caracteres en la URL
        let tipoPausa = 'distracion';
        if (motivo.includes('Externas')) tipoPausa = 'externo';
        if (motivo.includes('Fatiga')) tipoPausa = 'cansancio';

        const urlLimpia = window.location.origin + urlBase + '/estudio/registrar_escape/' + tipoPausa;

        console.log("Despachando escape por GET a:", urlLimpia);

        fetch(urlLimpia, {
            method: 'GET',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            },
            credentials: 'include'
        })
        .then(res => {
            if (!res.ok) throw new Error('Código: ' + res.status);
            return res.json();
        })
        .then(data => {
            alert(data.message);
            if(data.status !== 'error') {
                location.reload();
            }
        })
        .catch(err => {
            console.error('Error detectado en escape:', err);
            alert('No se pudo establecer la pausa de enfoque.');
        });
    }
}
</script>