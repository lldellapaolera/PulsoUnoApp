<div id="alert-container" class="w-100 mb-3"></div>

<div class="card border-0 shadow-sm rounded-4 mb-3 bg-white">
    <div class="card-body p-4">
        <h5 class="fw-bold mb-3" style="color: #111827;">🚗 Buscar Viaje Compartido</h5>
        
        <form id="form-buscar-viaje" class="row g-2">
            <div class="col-12">
                <label class="form-label small fw-semibold text-secondary mb-1">Tu rol actual:</label>
                <select id="pool-rol" class="form-select border-light-subtle bg-light">
                    <option value="acompañante">Soy Acompañante (Busco Conductor)</option>
                    <option value="conductor">Soy Conductor (Ofrezco Lugar)</option>
                </select>
            </div>

            <div class="col-12">
                <label class="form-label small fw-semibold text-secondary mb-1">Localidad o Zona del Oeste:</label>
                <div class="input-group">
                    <input type="text" id="pool-localidad" class="form-control border-light-subtle bg-light" placeholder="Ej: Merlo, Padua, Ituzaingó..." required>
                    <button class="btn btn-primary text-white fw-bold" type="submit" style="background-color: #0096d6; border-color: #0096d6;">
                        🔍 Buscar
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="mb-2 d-flex justify-content-between align-items-center px-1">
    <span class="text-secondary small fw-semibold">Coincidencias encontradas</span>
    <span class="badge rounded-pill bg-secondary-subtle text-secondary" id="total-resultados">0 disponibles</span>
</div>

<div id="contenedor-viajes" class="row g-3">
    <div class="col-12 text-center py-5 text-muted" id="estado-vacio-pool">
        <span class="fs-1 d-block mb-2">📍</span>
        <p class="small mb-0">Ingresá tu localidad arriba para encontrar compañeros de cursada que hagan tu misma ruta.</p>
    </div>
</div>

<template id="template-tarjeta-viaje">
    <div class="col-12">
        <div class="card border-0 shadow-sm rounded-4 card-viaje-pool bg-white">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <h6 class="fw-bold mb-0 nombre-usuario" style="color: #111827;">-</h6>
                        <span class="badge bg-primary-subtle text-primary small tipo-viaje mt-1" style="background-color: #0096d620 !important; color: #0096d6 !important;">-</span>
                    </div>
                    <div class="text-end">
                        <span class="text-secondary d-block" style="font-size: 0.75rem;">Hora Salida</span>
                        <span class="fw-bold hora-viaje text-dark">-</span>
                    </div>
                </div>
                
                <div class="bg-light p-2 rounded-3 my-2" style="font-size: 0.85rem;">
                    <div class="mb-1"><strong>📍 Origen:</strong> <span class="origen-viaje">-</span></div>
                    <div><strong>🎯 Destino:</strong> <span class="destino-viaje">-</span></div>
                </div>

                <p class="text-muted small mb-3 detalles-viaje">-</p>

                <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                    <span class="small text-secondary dias-viaje">📅 -</span>
                    <a href="#" target="_blank" class="btn btn-success btn-sm rounded-3 fw-bold px-3 btn-whatsapp">
                        💬 Coordinar
                    </a>
                </div>
            </div>
        </div>
    </div>
</template>

<style>
    .card-viaje-pool { border-left: 4px solid #0096d6 !important; }
</style>