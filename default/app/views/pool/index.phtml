<script>
document.addEventListener("DOMContentLoaded", function() {
    const panelGps = document.getElementById('panel-gps');
    if (panelGps) panelGps.classList.remove('d-none');

    let miIntervaloPool = null;

    function ejecutarBusquedaReal() {
        const rol = document.getElementById('pool-rol').value;
        const localidad = document.getElementById('pool-localidad').value;
        if (!localidad) return;

        const contenedor = document.getElementById('contenedor-viajes');
        const estadoVacio = document.getElementById('estado-vacio-pool');
        const totalBadge = document.getElementById('total-resultados');

        const urlBusqueda = "<?= PUBLIC_PATH ?>pool/buscar?tipo=" + rol + "&localidad=" + encodeURIComponent(localidad);

        fetch(urlBusqueda)
            .then(response => response.json())
            .then(data => {
                if (!data || data.length === 0) {
                    contenedor.querySelectorAll('.class-item-viaje').forEach(el => el.remove());
                    estadoVacio.style.display = 'block';
                    totalBadge.textContent = "0 disponibles";
                    return;
                }

                estadoVacio.style.display = 'none';
                totalBadge.textContent = data.length + " disponibles";

                data.forEach(viaje => {
                    let tarjetaExistente = document.getElementById("viaje-card-" + viaje.id);
                    
                    // Lógica para renderizar los botones correctos de seguridad
                    let htmlBotones = "";
                    if (viaje.solicitud_estado === 'ninguna') {
                        htmlBotones = `<button class="btn btn-primary btn-sm rounded-3 fw-bold px-3 btn-solicitar" data-id="${viaje.id}">📩 Solicitar Viaje</button>`;
                    } else if (viaje.solicitud_estado === 'pendiente') {
                        htmlBotones = `<span class="badge bg-warning-subtle text-warning p-2 rounded-3 small">⏳ Esperando Aceptación</span>`;
                    } else if (viaje.solicitud_estado === 'rechazado') {
                        htmlBotones = `<span class="badge bg-danger-subtle text-danger p-2 rounded-3 small">❌ Solicitud Rechazada</span>`;
                    } else if (viaje.solicitud_estado === 'aceptado') {
                        // Si está aceptado, habilitamos los datos reales del viaje
                        let linkGps = (viaje.latitud && viaje.longitud) ? `<a href="https://maps.google.com/?q=${viaje.latitud},${viaje.longitud}" target="_blank" class="btn btn-outline-danger btn-sm rounded-3 fw-bold px-2">📍 En Vivo</a>` : '';
                        htmlBotones = `${linkGps} <a href="https://wa.me/${viaje.telefono}" target="_blank" class="btn btn-success btn-sm rounded-3 fw-bold px-3">💬 Coordinar</a>`;
                    }

                    if (tarjetaExistente) {
                        // Actualizamos los botones dinámicamente en el bucle en vivo
                        tarjetaExistente.querySelector('.accion-contenedor').innerHTML = htmlBotones;
                    } else {
                        const template = document.getElementById('template-tarjeta-viaje');
                        const clon = template.content.cloneNode(true);
                        
                        clon.querySelector('.class-item-viaje').id = "viaje-card-" + viaje.id;
                        clon.querySelector('.nombre-usuario').textContent = viaje.nombre;
                        clon.querySelector('.tipo-viaje').textContent = viaje.tipo === 'conductor' ? '🚗 Conductor Disp.' : '🚶 Busca Chofer';
                        clon.querySelector('.hora-viaje').textContent = viaje.hora;
                        clon.querySelector('.origen-viaje').textContent = viaje.origen;
                        clon.querySelector('.destino-viaje').textContent = viaje.destino;
                        clon.querySelector('.detalles-viaje').textContent = viaje.detalles;
                        clon.querySelector('.dias-viaje').textContent = "📅 " + viaje.dias;
                        clon.querySelector('.accion-contenedor').innerHTML = htmlBotones;

                        contenedor.appendChild(clon);
                    }
                });

                // Asignamos el evento click a los nuevos botones de solicitar creados
                document.querySelectorAll('.btn-solicitar').forEach(btn => {
                    btn.onclick = function() {
                        const vId = this.getAttribute('data-id');
                        const fd = new FormData();
                        fd.append('viaje_id', vId);

                        fetch('<?= PUBLIC_PATH ?>pool/solicitar_viaje', { method: 'POST', body: fd })
                            .then(r => r.json())
                            .then(res => {
                                if(res.status === 'success') ejecutarBusquedaReal(); // Recarga al instante
                            });
                    };
                });
            });
    }

    document.getElementById('form-buscar-viaje').addEventListener('submit', function(e) {
        e.preventDefault();
        if (miIntervaloPool !== null) clearInterval(miIntervaloPool);
        ejecutarBusquedaReal();
        miIntervaloPool = setInterval(ejecutarBusquedaReal, 10000);
    });

    // 3. Lógica del Switch de Geolocalización Avanzado (Segundo Plano)
    // ================================================================
// 💾 CONTROL DEL SWITCH DE GEOLOCALIZACIÓN CON MEMORIA PERSISTENTE
// ================================================================
    const switchGps = document.getElementById('switch-gps');
    const alertaPermisos = document.getElementById('alerta-permisos-background');
    const statusText = document.getElementById('gps-status');
    const icon = document.getElementById('gps-icon');
    let intervaloLocalizado = null;

    // 1. FUNCIÓN CENTRALIZADA PARA ENCENDER EL RASTREO
    function encenderGpsVisualYLogico() {
        if (!navigator.geolocation) {
            alert("Tu GPS no está disponible en este dispositivo.");
            if (switchGps) switchGps.checked = false;
            return;
        }

        // Ajustes visuales
        if (switchGps) switchGps.checked = true;
        if (alertaPermisos) alertaPermisos.classList.remove('d-none');
        if (statusText) statusText.textContent = "Señal activa (Transmitiendo de fondo)...";
        if (icon) icon.textContent = "🟢";

        // Guardamos estado de permanencia
        localStorage.setItem('gps_tracking_activo', 'true');

        // Iniciamos bucle de transmisión en primer plano (mientras la pestaña esté abierta)
        if (intervaloLocalizado) clearInterval(intervaloLocalizado);
        intervaloLocalizado = setInterval(() => {
            navigator.geolocation.getCurrentPosition(position => {
                enviarCoordenadasServidor(position.coords.latitude, position.coords.longitude);
            }, null, { enableHighAccuracy: true });
        }, 15000);

        // Le avisamos al Service Worker que mantenga el hilo vivo de fondo
        if (navigator.serviceWorker && navigator.serviceWorker.controller) {
            navigator.serviceWorker.controller.postMessage({ action: 'START_BACKGROUND_TRACKING' });
        }
    }

    // 2. FUNCIÓN CENTRALIZADA PARA APAGAR EL RASTREO
    function apagarGpsVisualYLogico() {
        if (switchGps) switchGps.checked = false;
        if (alertaPermisos) alertaPermisos.classList.add('d-none');
        if (statusText) statusText.textContent = "GPS desactivado.";
        if (icon) icon.textContent = "📡";

        localStorage.removeItem('gps_tracking_activo');
        if (intervaloLocalizado) clearInterval(intervaloLocalizado);
        
        if (navigator.serviceWorker && navigator.serviceWorker.controller) {
            navigator.serviceWorker.controller.postMessage({ action: 'STOP_BACKGROUND_TRACKING' });
        }
    }

    // 3. VERIFICACIÓN INICIAL (Al cargar la página o volver de otra sección)
    if (localStorage.getItem('gps_tracking_activo') === 'true') {
        // Si ya estaba activo antes de ir a "Apuntes", lo reanudamos al toque
        encenderGpsVisualYLogico();
    }

    // 4. ESCUCHADOR DEL SWITCH (Acción manual del usuario)
    if (switchGps) {
        switchGps.addEventListener('change', function() {
            if (this.checked) {
                encenderGpsVisualYLogico();
            } else {
                apagarGpsVisualYLogico();
            }
        });
    }                                     

    // Función auxiliar para centralizar el fetch de ubicación
    function enviarCoordenadasServidor(lat, lng) {
        const formData = new FormData();
        formData.append('lat', lat);
        formData.append('lng', lng);

        fetch('<?= PUBLIC_PATH ?>pool/actualizar_posicion', {
            method: 'POST',
            body: formData
        })
        .then(res => res.json())
        .catch(err => console.error("Error GPS sync:", err));
    }
    // ==========================================
    // 🌐 LÓGICA DEL RADAR PROACTIVO (LEAFLET MAP)
    // ==========================================
    let mapa = null;
    let grupoMarcadores = null;
    let miLatitudActual = -34.6656; // Por defecto Merlo
    let miLongitudActual = -58.7281;

    // Inicializamos el mapa centrado en el Oeste
    if (document.getElementById('mapa-comunidad')) {
        mapa = L.map('mapa-comunidad').setView([miLatitudActual, miLongitudActual], 14);
        
        // Cargamos la capa visual estética de OpenStreetMap
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap colaboradores'
        }).addTo(mapa);

        grupoMarcadores = L.layerGroup().addTo(mapa);
    }

    function procesarRadarYMapa() {
        // Solicitamos primero nuestra ubicación real para enviársela a la API de Haversine
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(function(position) {
                miLatitudActual = position.coords.latitude;
                miLongitudActual = position.coords.longitude;
                
                // Centramos el mapa en nuestra posición real
                mapa.setView([miLatitudActual, miLongitudActual], 14);
                
                ejecutarCargaRadarBackend();
            }, function(error) {
                // Si el usuario tiene el GPS apagado en la PC, carga igual con la posición base
                ejecutarCargaRadarBackend();
            });
        }
    }

    function ejecutarCargaRadarBackend() {
        const listaContenedor = document.getElementById('lista-radar-cercania');
        if (!listaContenedor) return;

        // Limpiamos los marcadores viejos del mapa
        grupoMarcadores.clearLayers();

        // Dibujamos NUESTRO marcador (Azul)
        L.marker([miLatitudActual, miLongitudActual])
         .addTo(grupoMarcadores)
         .bindPopup("<b>📍 Estás acá</b><br>Tu posición actual de transmisión.")
         .openPopup();

        // Consultamos al controlador pasándole nuestras coordenadas reales
        fetch(`<?= PUBLIC_PATH ?>pool/obtener_usuarios_cercanos?lat=${miLatitudActual}&lng=${miLongitudActual}`)
            .then(res => res.json())
            .then(usuarios => {
                if (!usuarios || usuarios.length === 0) {
                    listaContenedor.innerHTML = `<div class="col-12 text-center text-muted small py-2">No hay otros usuarios transmitiendo en vivo cerca tuyo en este momento.</div>`;
                    return;
                }

                listaContenedor.innerHTML = ""; // Limpiamos el texto de carga

                usuarios.forEach(u => {
                    // 1. DIBUJAR EN EL MAPAINTERACTIVO
                    // Si es conductor usamos color verde, si es acompañante color naranja
                    const iconoColor = u.tipo === 'conductor' ? '🚗' : '🚶';
                    
                    L.marker([u.latitud, u.longitud])
                     .addTo(grupoMarcadores)
                     .bindPopup(`
                        <b>${iconoColor} ${u.nombre} (${ucfirst(u.tipo)})</b><br>
                        Distancia: ${u.distancia} km<br>
                        <button class="btn btn-primary btn-sm w-100 mt-2 text-white fw-bold py-1" onclick="proponerViajeDirecto(${u.id})">📩 Proponer Viaje</button>
                     `);

                    // 2. DIBUJAR EN EL LISTADO INFERIOR CON DISTANCIA
                    // Convertimos la distancia a un formato amigable (metros o km)
                    const distanciaTexto = u.distancia < 1 ? `${Math.round(u.distancia * 1000)} metros` : `${u.distancia} km`;
                    const badgeRol = u.tipo === 'conductor' ? 'bg-success-subtle text-success' : 'bg-warning-subtle text-warning';

                    const divItem = document.createElement('div');
                    divItem.className = "col-12 col-sm-6";
                    divItem.innerHTML = `
                        <div class="p-3 bg-light rounded-4 d-flex justify-content-between align-items-center border-0 shadow-sm">
                            <div>
                                <span class="badge ${badgeRol} small mb-1">${ucfirst(u.tipo)}</span>
                                <strong class="text-dark d-block">${u.nombre}</strong>
                                <span class="text-muted d-block" style="font-size: 0.75rem;">📍 A <strong>${distanciaTexto}</strong> de tu ubicación</span>
                            </div>
                            <button class="btn btn-sm btn-primary rounded-3 text-white fw-bold px-3" onclick="proponerViajeDirecto(${u.id})">
                                📩 Invitar
                            </button>
                        </div>
                    `;
                    listaContenedor.appendChild(divItem);
                });
            });
    }

    // Helper simple para capitalizar textos
    function ucfirst(str) { return str.charAt(0).toUpperCase() + str.slice(1); }

    // Función global para disparar la propuesta
    window.proponerViajeDirecto = function(viajeId) {
        const fd = new FormData();
        fd.append('viaje_id', viajeId);

        fetch('<?= PUBLIC_PATH ?>pool/solicitar_viaje', { method: 'POST', body: fd })
            .then(r => r.json())
            .then(res => {
                alert("¡Propuesta enviada! Le brotará una notificación al compañero en su pantalla de inmediato.");
                procesarRadarYMapa(); // Recargamos el mapa dinámicamente
            });
    }

    // Ejecutamos el radar al iniciar la página
    procesarRadarYMapa();
    // Lo refrescamos silenciosamente cada 15 segundos para capturar el movimiento de la gente en la calle
    setInterval(procesarRadarYMapa, 15000);
});

// Función para descartar las notificaciones en vivo
function marcarNotificacionLeida(id, elementoBoton) {
    // Apuntamos a un endpoint rápido o resolvemos directo por AJAX
    const formData = new FormData();
    formData.append('id', id);

    // Animación suave para hacer desaparecer la alerta de la pantalla
    const alertaDiv = elementoBoton.closest('.alert');
    if (alertaDiv) {
        alertaDiv.style.transition = "all 0.3s ease";
        alertaDiv.style.opacity = "0";
        setTimeout(() => alertaDiv.remove(), 300);
    }

    // Le avisamos a la base de datos que el usuario ya leyó este mensaje
    // Podés crear una acción rápida en tu controlador para cambiar el campo 'leido' a 1
    fetch('<?= PUBLIC_PATH ?>pool/marcar_notificacion_leida/' + id, { method: 'POST' });
}


// 🔔 FUNCIÓN PARA BUSCAR NOTIFICACIONES EN SEGUNDO PLANO
    function chequearNotificacionesEnVivo() {
        const contenedorAlertas = document.getElementById('contenedor-alertas-comunidad');
        if (!contenedorAlertas) return;

        fetch('<?= PUBLIC_PATH ?>pool/obtener_notificaciones_ajax')
            .then(res => res.json())
            .then(notificaciones => {
                // Guardamos los IDs de las alertas que ya se están mostrando para no duplicar
                const alertasActuales = Array.from(contenedorAlertas.querySelectorAll('[data-notif-id]'))
                                             .map(el => el.getAttribute('data-notif-id'));

                notificaciones.forEach(notif => {
                    // Si la alerta ya está en pantalla, no la volvemos a pintar
                    if (alertasActuales.includes(notif.id.toString())) return;

                    // Creamos la alerta dinámicamente con estilos Bootstrap
                    const divAlerta = document.createElement('div');
                    divAlerta.className = "alert alert-info border-0 shadow-sm rounded-4 d-flex justify-content-between align-items-center p-3 mb-2 bg-white animate-fade-in";
                    divAlerta.style.borderLeft = "4px solid #0096d6 !important";
                    divAlerta.setAttribute('data-notif-id', notif.id);
                    divAlerta.style.opacity = "0";
                    divAlerta.style.transform = "translateY(-10px)";
                    divAlerta.style.transition = "all 0.4s ease";

                    divAlerta.innerHTML = `
                        <div class="d-flex align-items-center gap-2">
                            <span class="fs-5">🔔</span>
                            <span class="small text-dark fw-medium">${notif.mensaje}</span>
                        </div>
                        <button type="button" class="btn-close small" style="font-size: 0.75rem;" onclick="marcarNotificacionLeida(${notif.id}, this)"></button>
                    `;

                    // Metemos la alerta arriba de todo
                    contenedorAlertas.insertBefore(divAlerta, contenedorAlertas.firstChild);
                    
                    // Efecto visual de entrada fluida (Slide Down)
                    setTimeout(() => {
                        divAlerta.style.opacity = "1";
                        divAlerta.style.transform = "translateY(0)";
                    }, 50);
                });
            })
            .catch(err => console.error("Error al sincronizar alertas:", err));
    }

    // Ejecutamos el chequeo apenas carga la app
    chequearNotificacionesEnVivo();

    // ⏳ Bucle de Alertas: Revisa silenciosamente cada 5 segundos
    setInterval(chequearNotificacionesEnVivo, 5000);
</script>