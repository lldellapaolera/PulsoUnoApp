<style>
    .hover-asistencia:active {
        background-color: #f8f9fa;
    }
    .form-check-input:checked {
        background-color: #0096d6 !important;
        border-color: #0096d6 !important;
    }
    .badge-fecha-guardada:hover {
        background-color: #198754 !important;
        color: #ffffff !important;
    }
</style>

<script>
// 1. Selector de comisiones
document.getElementById('selector-comision').addEventListener('change', function() {
    const id = this.value;
    window.location.href = id ? "<?= PUBLIC_PATH ?>asistencia/index/" + id : "<?= PUBLIC_PATH ?>asistencia";
});

// Mecánica interna de asistencia AJAX (solo si hay comisión cargada)
if(document.getElementById('form-asistencia')) {
    const checks = document.querySelectorAll('.check-alumno');
    const contador = document.getElementById('contador-presentes');
    const inputFecha = document.getElementById('fecha-asistencia');
    const comisionId = document.getElementById('comision-id').value;

    function actualizarContador() {
        const totales = checks.length;
        const presentes = document.querySelectorAll('.check-alumno:checked').length;
        contador.textContent = `${presentes} / ${totales}`;
    }

    checks.forEach(chk => chk.addEventListener('change', actualizarContador));

    // 🚨 NUEVA FUNCIÓN: Consulta el servidor para sincronizar los switches según la fecha elegida
    function cargarEstadoAsistenciaPorFecha(fechaElegida) {
        fetch(`<?= PUBLIC_PATH ?>asistencia/obtener_asistencia_fecha?comision_id=${comisionId}&fecha=${fechaElegida}`, {
            method: 'GET',
            credentials: 'include'
        })
        .then(response => response.json())
        .then(data => {
            if (data.status === 'success') {
                if (data.existe_registro) {
                    // Si el día tiene datos guardados, mapeamos cada checkbox con su valor real (1 = tildado, 0 = vacío)
                    checks.forEach(chk => {
                        const alumnoId = chk.value;
                        chk.checked = (data.asistencias[alumnoId] === 1);
                    });
                } else {
                    // Si es un día nuevo sin registros, los dejamos a todos Presentes por defecto
                    checks.forEach(chk => chk.checked = true);
                }
                actualizarContador();
            }
        })
        .catch(err => console.error("Error cargando historial de fecha:", err));
    }

    // Escuchamos el cambio de fecha del input calendario
    inputFecha.addEventListener('change', function() {
        cargarEstadoAsistenciaPorFecha(this.value);
    });

    // Permitir hacer clic directo en los badges verdes de fechas registradas para saltar rápido a ese día
    document.querySelectorAll('.badge-fecha-guardada').forEach(badge => {
        badge.addEventListener('click', function() {
            const fechaBadge = this.getAttribute('data-fecha');
            inputFecha.value = fechaBadge;
            cargarEstadoAsistenciaPorFecha(fechaBadge);
        });
    });

    // Inicialización automática al cargar la vista
    cargarEstadoAsistenciaPorFecha(inputFecha.value);

    // 2. Envío del formulario
    document.getElementById('form-asistencia').addEventListener('submit', function(e) {
        e.preventDefault();
        const btn = document.getElementById('btn-guardar');
        const alertContainer = document.getElementById('alert-container');
        
        btn.disabled = true;
        btn.textContent = '⏳ Procesando guardado...';

        const datosPost = new URLSearchParams();
        datosPost.append('comision_id', comisionId);
        datosPost.append('fecha', inputFecha.value);

        document.querySelectorAll('.check-alumno:checked').forEach(chk => {
            datosPost.append('presentes[]', chk.value);
        });

        fetch('<?= PUBLIC_PATH ?>asistencia/guardar', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: datosPost,
            credentials: 'include'
        })
        .then(response => response.json())
        .then(data => {
            alertContainer.innerHTML = '';
            const div = document.createElement('div');
            div.className = `alert rounded-3 p-3 alert-dismissible fade show ${data.status === 'success' ? 'alert-success' : 'alert-danger'}`;
            div.innerHTML = `
                <strong>${data.status === 'success' ? '✅ Éxito:' : '❌ Error:'}</strong> ${data.message}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            `;
            alertContainer.appendChild(div);
            window.scrollTo({ top: 0, behavior: 'smooth' });

            // Si se guardó con éxito una fecha nueva, recargamos sutilmente la UI para actualizar el badge verde
            if (data.status === 'success') {
                setTimeout(() => window.location.reload(), 1200);
            }
        })
        .catch(err => {
            console.error(err);
            alert('Error inesperado de comunicación.');
        })
        .finally(() => {
            btn.disabled = false;
            btn.textContent = '💾 Guardar Asistencia';
        });
    });
}
</script>