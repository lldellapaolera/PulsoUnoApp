<script>
document.addEventListener("DOMContentLoaded", function() {
    const alertOffline = document.getElementById('offline-login-alert');
    const btnSubmit = document.getElementById('btn-login-submit');
    const inputLegajo = document.getElementById('login-legajo');
    const inputPass = document.getElementById('login-password');

    function verificarEstadoRed() {
        // 1. Primer chequeo nativo del navegador
        if (!navigator.onLine) {
            aplicarModoOffline();
        } else {
            // 2. 🚀 SOLUCIÓN PARA ANDROID: Si dice que está Online, hacemos una mini prueba real 
            // para evitar el falso positivo del arranque en frío.
            fetch('<?= PUBLIC_PATH ?>manifest.json', { method: 'HEAD', cache: 'no-store' })
                .then(function() {
                    // Si el fetch responde (aunque sea desde el SW), hay entorno vivo
                    aplicarModoOnline();
                })
                .catch(function() {
                    // Si el fetch falla por completo (red caída de verdad), va a offline
                    aplicarModoOffline();
                });
        }
    }

    function aplicarModoOffline() {
        alertOffline.classList.remove('d-none');
        if (btnSubmit) {
            btnSubmit.disabled = true;
            btnSubmit.innerText = "Modo Offline - Bloqueado";
        }
        if (inputLegajo) inputLegajo.disabled = true;
        if (inputPass) inputPass.disabled = true;
    }

    function aplicarModoOnline() {
        alertOffline.classList.add('d-none');
        if (btnSubmit) {
            btnSubmit.disabled = false;
            btnSubmit.innerText = "Sign In";
        }
        if (inputLegajo) inputLegajo.disabled = false;
        if (inputPass) inputPass.disabled = false;
    }

    // Escuchar cambios de red mientras la app está abierta
    window.addEventListener('online', verificarEstadoRed);
    window.addEventListener('offline', verificarEstadoRed);

    // Ejecutar la verificación inicial con un mini delay de 300ms 
    // para darle tiempo al sistema operativo de Android a estabilizar la red de la PWA
    setTimeout(verificarEstadoRed, 300);
});
</script>